# Flask
# SECURITY NOTE:
# - Do NOT commit your real `.env` file (secrets/credentials).
# - Keep using this `.env.example` as a safe template.
FLASK_ENV=development
SECRET_KEY=change-me

# Database
# PostgreSQL (recommended)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dss_car_advisor

# Data/model paths
CARS_CSV_PATH=./cars.csv
MODEL_PATH=./models/car_advisor_rf.pkl
